<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PLYT — Hydration with a Pulse</title>
  <meta name="description" content="PLYT is performance hydration built for the full session. Starting with CHARGE (Mango) and IGNITE (Lemon Mint)." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #F3EFE6;
      --black: #0E0E0E;
      --orange: #FF5A2B;
      --lime: #D6FF3D;
      --gray: #58534B;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--cream);
      color: var(--black);
      line-height: 1.5;
    }

    .mono { font-family: 'IBM Plex Mono', monospace; }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(243, 239, 230, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(14,14,14,0.08);
      padding: 1.1rem 0;
    }

    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 5vw;
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 900;
      font-size: 1.4rem;
      letter-spacing: -0.03em;
    }

    .slash {
      width: 11px;
      height: 26px;
      background: var(--orange);
      transform: skewX(-18deg);
      display: inline-block;
    }

    .header-actions {
      display: flex;
      gap: 0.7rem;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      height: 40px;
      padding: 0 1.1rem;
      border-radius: 100px;
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .pill.outline {
      border: 1.5px solid rgba(14,14,14,0.2);
    }

    .pill.black {
      background: var(--black);
      color: var(--cream);
    }

    .pill:hover { transform: translateY(-2px); }

    /* Hero */
    .hero {
      padding: 4rem 0 5rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
      align-items: center;
    }

    .badge-row {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 1.8rem;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      height: 34px;
      padding: 0 0.9rem;
      border-radius: 100px;
      font-size: 0.78rem;
      font-weight: 600;
    }

    .badge.outline {
      background: white;
      border: 1.5px solid rgba(14,14,14,0.15);
    }

    .badge.black {
      background: var(--black);
      color: white;
    }

    .dot {
      width: 7px;
      height: 7px;
      background: var(--orange);
      border-radius: 50%;
    }

    h1 {
      font-size: clamp(2.8rem, 6.5vw, 5rem);
      font-weight: 900;
      line-height: 0.92;
      letter-spacing: -0.03em;
      text-transform: uppercase;
    }

    h1 span { color: var(--orange); }

    .hero-sub {
      margin: 1.5rem 0 2rem;
      font-size: 1.1rem;
      color: var(--gray);
      max-width: 42ch;
    }

    .cta-row {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      height: 52px;
      padding: 0 1.6rem;
      border-radius: 100px;
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      border: 2px solid transparent;
    }

    .btn-primary {
      background: var(--orange);
      color: var(--black);
      border-color: var(--black);
    }

    .btn-secondary {
      background: transparent;
      border-color: rgba(14,14,14,0.25);
    }

    .btn:hover {
      transform: translateY(-3px) scale(1.03);
    }

    /* Progress */
    .progress-block { max-width: 380px; }
    .progress-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--gray);
      margin-bottom: 0.45rem;
    }
    .progress-track {
      height: 6px;
      background: rgba(14,14,14,0.1);
      border-radius: 100px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 0;
      background: var(--orange);
      border-radius: 100px;
      transition: width 1.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    /* Floating cards */
    .hero-visual {
      position: relative;
      height: 420px;
    }

    .float-card {
      position: absolute;
      width: 170px;
      height: 190px;
      border-radius: 20px;
      border: 2.5px solid var(--black);
      box-shadow: 6px 6px 0 var(--black);
      padding: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      animation: float 5.5s ease-in-out infinite;
    }

    .float-card img {
      width: 100%;
      height: 90px;
      object-fit: contain;
      margin: 0.3rem 0;
    }

    .float-card .name {
      font-weight: 900;
      font-size: 1.15rem;
      text-transform: uppercase;
    }

    .fc-1 {
      background: var(--orange);
      top: 10%;
      left: 5%;
      --r: -6deg;
      animation-delay: 0s;
    }

    .fc-2 {
      background: var(--lime);
      top: 5%;
      right: 8%;
      --r: 5deg;
      animation-delay: -1.8s;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(var(--r)); }
      50% { transform: translateY(-16px) rotate(var(--r)); }
    }

    /* Flavours Section */
    .flavours {
      padding: 5rem 0 6rem;
    }

    .eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--orange);
      margin-bottom: 0.8rem;
      display: block;
    }

    h2 {
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 900;
      line-height: 0.95;
      text-transform: uppercase;
      letter-spacing: -0.02em;
    }

    .ghost {
      -webkit-text-stroke: 2px var(--black);
      color: transparent;
    }

    .section-sub {
      margin: 1.2rem 0 2.8rem;
      color: var(--gray);
      max-width: 46ch;
      font-size: 1.05rem;
    }

    .flavour-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .flav-card {
      border-radius: 24px;
      border: 2.5px solid var(--black);
      box-shadow: 7px 7px 0 var(--black);
      padding: 1.8rem;
      min-height: 380px;
      display: flex;
      flex-direction: column;
      transition: all 0.35s ease;
      opacity: 0;
      transform: translateY(25px);
    }

    .flav-card.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    .flav-card:hover {
      transform: translateY(-6px);
      box-shadow: 10px 12px 0 var(--black);
    }

    .flav-card.charge { background: var(--orange); }
    .flav-card.ignite { background: var(--lime); }

    .flav-top {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .flav-tag {
      border: 1.5px solid currentColor;
      border-radius: 100px;
      padding: 0.2rem 0.65rem;
      font-size: 0.7rem;
    }

    .flav-card img {
      width: 140px;
      height: 160px;
      object-fit: contain;
      margin: 1.2rem auto;
      filter: drop-shadow(4px 6px 0 rgba(0,0,0,0.15));
      transition: transform 0.3s ease;
    }

    .flav-card:hover img {
      transform: scale(1.06) rotate(-2deg);
    }

    .flav-name {
      font-size: 1.7rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .flav-flavor {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.9rem;
      font-weight: 600;
      margin: 0.25rem 0 0.7rem;
    }

    .flav-desc {
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* Closing */
    .closing {
      background: var(--orange);
      padding: 5.5rem 0;
      text-align: center;
    }

    .closing h2 {
      margin: 1.2rem 0 1rem;
    }

    .closing p {
      max-width: 44ch;
      margin: 0 auto 2rem;
      color: rgba(14,14,14,0.75);
    }

    .capture {
      display: flex;
      max-width: 460px;
      margin: 0 auto;
      background: var(--cream);
      border: 2px solid var(--black);
      border-radius: 100px;
      padding: 5px;
      gap: 5px;
    }

    .capture input {
      flex: 1;
      border: none;
      background: transparent;
      padding: 0 1.1rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.95rem;
      outline: none;
    }

    .capture button {
      height: 48px;
      padding: 0 1.4rem;
      background: var(--black);
      color: var(--cream);
      border: none;
      border-radius: 100px;
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 700;
      cursor: pointer;
    }

    /* Footer */
    footer {
      background: var(--black);
      color: rgba(243,239,230,0.6);
      padding: 3.5rem 0 2rem;
    }

    .foot-bottom {
      border-top: 1px solid rgba(243,239,230,0.12);
      padding-top: 1.4rem;
      margin-top: 2rem;
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-visual { display: none; }
      .flavour-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 600px) {
      .capture {
        flex-direction: column;
        background: transparent;
        border: none;
        padding: 0;
        gap: 0.6rem;
      }
      .capture input {
        background: var(--cream);
        border: 2px solid var(--black);
        border-radius: 100px;
        height: 50px;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="wrap header-inner">
      <div class="logo">
        <span class="slash"></span> PLYT
      </div>
      <div class="header-actions">
        <a href="https://instagram.com/drinkplyt" class="pill outline mono" target="_blank">@DRINKPLYT</a>
        <a href="#notify" class="pill black mono">JOIN THE DROP</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="badge-row">
          <span class="badge outline mono">✦ PERFORMANCE HYDRATION</span>
          <span class="badge black mono"><span class="dot"></span> DROP 01 LOADING</span>
        </div>

        <h1>
          Hydration<br>
          with a<br>
          <span>Pulse.</span>
        </h1>

        <p class="hero-sub">
          Two flavours. One job — keep you going when the session gets long. PLYT is performance hydration built for the grinders, the strivers, the ones still going.
        </p>

        <div class="cta-row">
          <a href="#notify" class="btn btn-primary">GET EARLY ACCESS ↓</a>
          <a href="#flavours" class="btn btn-secondary">MEET THE FLAVOURS</a>
        </div>

        <div class="progress-block">
          <div class="progress-labels mono">
            <span>DROP 01 — LOADING</span>
            <span>73%</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill" id="progressFill"></div>
          </div>
        </div>
      </div>

      <!-- Floating product cards -->
      <div class="hero-visual">
        <div class="float-card fc-1">
          <span class="mono" style="font-size:0.75rem;opacity:0.7">01</span>
          <img src="Charge.jfif" alt="PLYT Charge Mango">
          <div class="name">CHARGE</div>
        </div>
        <div class="float-card fc-2">
          <span class="mono" style="font-size:0.75rem;opacity:0.7">02</span>
          <img src="Ignite.jfif" alt="PLYT Ignite Lemon Mint">
          <div class="name">IGNITE</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Flavours -->
  <section class="flavours" id="flavours">
    <div class="wrap">
      <span class="eyebrow">/ THE FLAVOURS</span>
      <h2>TWO FLAVOURS. <span class="ghost">ONE JOB.</span></h2>
      <p class="section-sub">Same formulation. Same sachet. Only the flavour changes — pick the one that matches your session.</p>

      <div class="flavour-grid">
        <!-- CHARGE -->
        <div class="flav-card charge">
          <div class="flav-top mono">
            <span>SKU / 01</span>
            <span class="flav-tag">HERO</span>
          </div>
          <img src="Charge.jfif" alt="PLYT Charge - Mango">
          <div>
            <div class="flav-name">CHARGE</div>
            <div class="flav-flavor">MANGO</div>
            <p class="flav-desc">Bright and mango-forward. The one to reach for first, every session.</p>
          </div>
        </div>

        <!-- IGNITE -->
        <div class="flav-card ignite">
          <div class="flav-top mono">
            <span>SKU / 02</span>
            <span class="flav-tag">SECOND</span>
          </div>
          <img src="Ignite.jfif" alt="PLYT Ignite - Lemon Mint">
          <div>
            <div class="flav-name">IGNITE</div>
            <div class="flav-flavor">LEMON MINT</div>
            <p class="flav-desc">Sharp and clean. For when the heat is on and the game is still level.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing / Email -->
  <section class="closing" id="notify">
    <div class="wrap">
      <span class="badge" style="background:var(--cream);color:var(--black)">✨ EARLY ACCESS — DROP 01</span>
      <h2>Be first<br>in the room.</h2>
      <p>Drop your email and you’ll hear about Drop 01 before anyone else. No spam, ever.</p>

      <form class="capture" id="signupForm">
        <input type="email" id="emailInput" placeholder="you@example.com" required>
        <button type="submit">NOTIFY ME →</button>
      </form>
      <p id="formMsg" style="margin-top:1rem;font-family:'IBM Plex Mono';font-size:0.9rem;"></p>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="wrap">
      <div class="logo" style="color:var(--cream);margin-bottom:1rem">
        <span class="slash"></span> PLYT
      </div>
      <p style="max-width:260px;margin-bottom:1.5rem;font-size:0.95rem">
        Performance hydration built for the full session.
      </p>
      <div class="foot-bottom">
        <span>© 2026 PLYT. ALL RIGHTS RESERVED.</span>
        <span>PLYT.IN — MADE IN INDIA</span>
      </div>
    </div>
  </footer>

  <script>
    // Progress bar
    window.addEventListener('load', () => {
      document.getElementById('progressFill').style.width = '73%';
    });

    // Reveal cards on scroll
    const cards = document.querySelectorAll('.flav-card');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
        }
      });
    }, { threshold: 0.2 });
    cards.forEach(card => observer.observe(card));

    // Simple form message
    document.getElementById('signupForm').addEventListener('submit', function(e) {
      e.preventDefault();
      document.getElementById('formMsg').textContent = "You're on the list. We'll email you before Drop 01.";
      this.reset();
    });
  </script>
</body>
</html>
